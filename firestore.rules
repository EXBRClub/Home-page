rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validNewMember(userId) {
      return owns(userId)
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'role', 'rankId', 'avatarId', 'bannerId',
          'bio', 'favoriteClass', 'favoriteFaction',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'member'
        && request.resource.data.rankId == 'soldado'
        && request.resource.data.avatarId in ['assalto', 'pesado', 'reconhecimento']
        && request.resource.data.bannerId in ['brasil', 'comando', 'noturna']
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 220
        && request.resource.data.favoriteClass in ['', 'infiltrador', 'assalto-leve', 'medico', 'engenheiro', 'assalto-pesado', 'max']
        && request.resource.data.favoriteFaction in ['', 'tr', 'nc', 'vs', 'nso'];
    }

    function validMemberProfileUpdate(userId) {
      return owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'avatarId', 'bannerId', 'bio', 'favoriteClass', 'favoriteFaction', 'updatedAt'])
        && request.resource.data.avatarId in ['assalto', 'pesado', 'reconhecimento']
        && request.resource.data.bannerId in ['brasil', 'comando', 'noturna']
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 220
        && request.resource.data.favoriteClass in ['', 'infiltrador', 'assalto-leve', 'medico', 'engenheiro', 'assalto-pesado', 'max']
        && request.resource.data.favoriteFaction in ['', 'tr', 'nc', 'vs', 'nso'];
    }

    function validParticipation(userId, operationId) {
      return owns(userId)
        && request.resource.data.keys().hasOnly([
          'operationId', 'title', 'startsAt', 'status', 'userId',
          'displayName', 'joinedAt'
        ])
        && request.resource.data.operationId == operationId
        && request.resource.data.userId == userId
        && request.resource.data.status == 'confirmed';
    }

    function validPublicProfileCreate(userId) {
      return owns(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'rankId', 'avatarId', 'bannerId',
          'bio', 'favoriteClass', 'favoriteFaction',
          'featuredMedals', 'recentActivities', 'updatedAt'
        ])
        && request.resource.data.displayName == get(/databases/$(database)/documents/users/$(userId)).data.displayName
        && request.resource.data.rankId == get(/databases/$(database)/documents/users/$(userId)).data.rankId
        && request.resource.data.avatarId == get(/databases/$(database)/documents/users/$(userId)).data.avatarId
        && request.resource.data.bannerId == get(/databases/$(database)/documents/users/$(userId)).data.bannerId
        && request.resource.data.bio == get(/databases/$(database)/documents/users/$(userId)).data.bio
        && request.resource.data.favoriteClass == get(/databases/$(database)/documents/users/$(userId)).data.favoriteClass
        && request.resource.data.favoriteFaction == get(/databases/$(database)/documents/users/$(userId)).data.favoriteFaction
        && request.resource.data.featuredMedals is list
        && request.resource.data.featuredMedals.size() <= 5
        && request.resource.data.recentActivities is list
        && request.resource.data.recentActivities.size() <= 3;
    }

    function validPublicProfileUpdate(userId) {
      return owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'avatarId', 'bannerId', 'bio', 'favoriteClass', 'favoriteFaction', 'featuredMedals',
          'recentActivities', 'updatedAt'
        ])
        && request.resource.data.displayName == get(/databases/$(database)/documents/users/$(userId)).data.displayName
        && request.resource.data.rankId == get(/databases/$(database)/documents/users/$(userId)).data.rankId
        && request.resource.data.avatarId == get(/databases/$(database)/documents/users/$(userId)).data.avatarId
        && request.resource.data.bannerId == get(/databases/$(database)/documents/users/$(userId)).data.bannerId
        && request.resource.data.bio == get(/databases/$(database)/documents/users/$(userId)).data.bio
        && request.resource.data.favoriteClass == get(/databases/$(database)/documents/users/$(userId)).data.favoriteClass
        && request.resource.data.favoriteFaction == get(/databases/$(database)/documents/users/$(userId)).data.favoriteFaction
        && request.resource.data.featuredMedals is list
        && request.resource.data.featuredMedals.size() <= 5
        && request.resource.data.recentActivities is list
        && request.resource.data.recentActivities.size() <= 3;
    }

    match /users/{userId} {
      allow create: if validNewMember(userId);
      allow read: if owns(userId) || isAdmin();
      allow update: if isAdmin() || validMemberProfileUpdate(userId);
      allow delete: if isAdmin();

      match /medals/{medalId} {
        allow read: if owns(userId) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /participations/{operationId} {
        allow read: if owns(userId) || isAdmin();
        allow create: if validParticipation(userId, operationId);
        allow update, delete: if isAdmin();
      }
    }

    match /operations/{operationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /participants/{userId} {
        allow read: if owns(userId) || isAdmin();
        allow create: if validParticipation(userId, operationId);
        allow update, delete: if isAdmin();
      }
    }

    match /medalCatalog/{medalId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin() || validPublicProfileCreate(userId);
      allow update: if isAdmin() || validPublicProfileUpdate(userId);
      allow delete: if isAdmin();
    }

    match /communityGallery/{itemId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
